# Copied to .env by `composer create-project`, with a fresh secret. .env is never committed.
# Settings override config/ files: APP_A__B sets a.b (APP_APP__URL sets app.url).

APP_ENV=development

# 64 random hexadecimal characters: php -r "echo bin2hex(random_bytes(32));"
APP_SECURITY__SECRET=

# On the server:
# APP_ENV=production
# APP_APP__URL=https://www.example.com
