{
    "name": "mj-zana/skeleton-web",
    "description": "A starting point for a Zana website: pages in two languages, templates, security headers, and release archives for shared hosting",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "zana",
        "skeleton",
        "website"
    ],
    "require": {
        "php": "^8.5",
        "mj-zana/cache": "^2.3",
        "mj-zana/console": "^2.3",
        "mj-zana/core": "^2.3",
        "mj-zana/http": "^2.3",
        "mj-zana/routing": "^2.3",
        "mj-zana/security": "^2.3",
        "mj-zana/translation": "^2.3",
        "mj-zana/view": "^2.3"
    },
    "require-dev": {
        "mj-zana/testing": "^2.3",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-zip": "Needed by release:build to write the upload archives"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || file_put_contents('.env', str_replace('APP_SECURITY__SECRET=', 'APP_SECURITY__SECRET=' . bin2hex(random_bytes(32)), file_get_contents('.env.example')));\""
        ],
        "serve": "@php -S localhost:8000 -t public",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../zana-audit",
            "options": {
                "symlink": true,
                "versions": {
                    "mj-zana/audit": "2.3.0"
                }
            }
        },
